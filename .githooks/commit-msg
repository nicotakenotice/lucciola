#!/bin/sh
# Enforces Conventional Commits and forbids attribution trailers.
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
    echo "commit-msg: the subject must follow Conventional Commits, e.g. 'feat(ui): add toggle'" >&2
    echo "  got: $first_line" >&2
    exit 1
fi

if grep -Eiq '^co-authored-by:' "$msg_file"; then
    echo "commit-msg: Co-Authored-By trailers are not allowed in this repository" >&2
    exit 1
fi
