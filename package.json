{
  "name": "lucciola",
  "private": true,
  "version": "0.1.0",
  "description": "Lucciola: an atmospheric browser game about a firefly surviving a dark night. Phaser 4 + React + TypeScript.",
  "license": "MIT",
  "keywords": [
    "game",
    "phaser",
    "phaser4",
    "react",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "verify:fast": "npm run typecheck && npm run lint && npm run test:unit",
    "verify": "npm run verify:fast && npm run test:e2e && npm run check:dist",
    "prepare": "git config core.hooksPath .githooks || true",
    "balance": "node scripts/balance.mjs",
    "package": "npm run build && npm run check:dist && node scripts/package.mjs",
    "images": "node scripts/images.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^30.1.1",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
  }
}
